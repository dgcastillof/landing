# Va en /srv/apps/caddy/sites/landing.caddy (ver README).
# Los archivos de la landing están en /srv/apps/caddy/sites/landing,
# que dentro del contenedor de Caddy es /etc/caddy/sites/landing.
dgcastillof.com.ar {
	root * /etc/caddy/sites/landing
	encode zstd gzip
	file_server {
		hide .git README.md landing.caddy
	}
}

www.dgcastillof.com.ar {
	redir https://dgcastillof.com.ar{uri} permanent
}
